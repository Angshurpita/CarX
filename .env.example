# CarX Environment Configuration Template

# Server & App Environment
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Vercel Monorepo Configuration
# On Vercel, the frontend & backend are deployed as a single project via vercel.json.
# In production on Vercel, NEXT_PUBLIC_API_URL defaults to /api/v1 (same domain).
# Only set NEXT_PUBLIC_API_URL if you host the backend on a separate custom domain.
# NEXT_PUBLIC_API_URL=/api/v1

# Database Configuration
# Default: Automatic SQLite fallback (in Vercel serverless, automatically copied to /tmp/carx.db)
# For persistent production storage, supply a PostgreSQL URL (e.g. Supabase, Neon, or Vercel Postgres):
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./carx.db

# OpenRouter / Gemma LLM Assistant Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_TOKENS=1200

# Google Gemini API Configuration (Optional alternative to OpenRouter)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Machine Learning & Valuation Artifacts (resolved automatically if not provided)
MODEL_ARTIFACT_PATH=./models/valuation_model.joblib
BASELINE_LOOKUP_PATH=./models/baseline_lookup.json
SAMPLE_DATA_PATH=data/sample/listings_sample.json

# Vercel Fluid Compute / Large Functions (Set this in Vercel Dashboard > Settings > Environment Variables):
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1
