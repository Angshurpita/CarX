{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend",
        "path": "/api/$1"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend",
        "path": "/health"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "backend",
        "path": "/docs"
      }
    },
    {
      "source": "/redoc",
      "destination": {
        "service": "backend",
        "path": "/redoc"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend",
        "path": "/openapi.json"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
